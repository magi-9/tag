# Django environment variables
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,tag.tomag.xyz

# Database
DB_NAME=tag_game
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# CORS (add your production domain)
CORS_ALLOWED_ORIGINS=https://tag.tomag.xyz,http://localhost:5173,http://localhost:3000

# CSRF Trusted Origins (required for Cloudflare)
CSRF_TRUSTED_ORIGINS=https://tag.tomag.xyz

# Security (enable in production with HTTPS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Admin Credentials (CHANGE THESE!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SecurePassword123!
ADMIN_EMAIL=admin@taggame.com

# VAPID Keys for Web Push (generate using: python manage.py generate_vapid_keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@taggame.com
